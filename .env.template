# Shared secrets for all *.reflex-ddns.com apps
# Docker Compose reads this file automatically and injects values
# into container environment variables via ${VAR} references.

# Cross-subdomain SSO: relack signs a JWT with this secret after
# Google login, other apps (md, vecdraw, ...) verify it with the
# same key. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DDNS_AUTH_SECRET=REPLACE_ME
