assets/external/
.states
*.db
*.py[cod]
.web
.web/
.states/
__pycache__/
/app/__pycache__/


# Ignore uploaded files
uploaded_files/

# pkg-cache: downloaded packages (apt, PyPI, npm, Node.js, ...) kept on the host
pkg_cache/data/

# Ignore environment variable files
.env
smart_launcher/.env.mount*

# Auto-generated by smart_launch.sh
docker-compose.smart-app*.yml

# BIND9 runtime configs (generated from *.template files at container startup)
docker/named.conf.local
docker/zones/db.reflex-ddns.com

# Ignore macOS system files
.DS_Store

# Runtime-generated service registry / manual DNS records
data/registry.json
data/manual_dns.json

# re-ddns state when it runs outside Docker (in Docker it lives in the registry-data volume):
# the admin token, install jobs, and the Owned Collections node's peers, settings and index
data/admin_token
data/install_jobs.json
data/collections_peers.json
data/collections_settings.json
data/collections_index.sqlite*

# Playwright / Test Artifacts
testcases/**/output/
.playwright-mcp/

# Documentation videos and related files
docs/videos/AgenticAppStore-Collections-promo.mp4
docs/videos/AgenticAppStore-Collections-promo.srt
docs/videos/collections-promo.src/
docs/videos/AgenticAppStore-RT-review-promo.en.mp4
docs/videos/AgenticAppStore-RT-review-promo.en.srt
docs/videos/AgenticAppStore-RT-review-promo.zh-TW.mp4
docs/videos/AgenticAppStore-RT-review-promo.zh-TW.srt
docs/videos/rt-review-promo.src/
reports/
research_notes/
docs/videos/AgenticAppStore-AI-CAD-promo.*
docs/videos/agentic-store-promo.src/
